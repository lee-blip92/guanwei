# 复制为 .env；密钥仅由后端读取。使用本地兼容服务时，密钥可以为空。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
MODEL_TIMEOUT=90
MODEL_BATCH_SIZE=10
MEDIACRAWLER_PATH=./md
# 留空时自动使用 md/.venv/Scripts/python.exe 或当前 Python
MEDIACRAWLER_PYTHON=
INSIGHT_DATA_DIR=./runtime

# DeepSeek official API: bounded structured extraction uses non-thinking mode by default.
# Set enabled to opt into thinking, then restart the backend.
DEEPSEEK_THINKING_MODE=disabled

# Optional: Node.js executable for the shared React HTML renderer (auto-detected by default).
REPORT_NODE_PATH=
